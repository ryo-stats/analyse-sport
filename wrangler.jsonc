// Robot d'alertes (Cloudflare Workers, offre gratuite). Code : worker/. Mis en ligne par Cloudflare à chaque push.
// Site ouvert : aucun code ni secret. Les clés de notification (VAPID) sont créées et gardées par le robot lui-même.
{
  "name": "analyse-sport-alertes",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [{ "name": "STATE", "class_name": "Etat" }, { "name": "SENDER", "class_name": "Envoi" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Etat"] }, { "tag": "v2", "new_sqlite_classes": ["Envoi"] }],
  "vars": { "SITE": "https://ryo-stats.github.io/analyse-sport/" },
  "keep_vars": true,
  "observability": { "enabled": true }
}
